NAVIGATOR_API_KEY=your_key_here
NAVIGATOR_BASE=https://api.ai.it.ufl.edu
NAVIGATOR_MODEL=granite-3.3-8b-instruct
NAVIGATOR_GRADING_MODEL=llama-3.3-70b-instruct
NAVIGATOR_TTS_MODEL=kokoro
NAVIGATOR_TTS_VOICE=af_heart
NAVIGATOR_TTS_SPEED=1
NAVIGATOR_TTS_TIMEOUT_MS=60000

NAVIGATOR_IMAGE_MODEL=flux.1-schnell
DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3001

# Use the existing Clerk application; never commit actual keys.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Comma-separated frontend origins allowed in session tokens (azp).
CLERK_AUTHORIZED_PARTIES=http://localhost:8081
